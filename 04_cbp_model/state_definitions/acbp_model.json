"building_type": ["IPD"],
"loc_nurse_unit_cd": "ENUM_FROM_DB",
"loc_room_cd": "ENUM_FROM_DB",
"loc_bed_cd": "ENUM_FROM_DB"
},
"constraints": [
{
"type": "IMPLIES",
"if": "f_bedded_census_live",
